# 编译产物
bin/
*.exe
# 仅忽略仓库根目录的 Linux 二进制 —— 必须带前导斜杠：
# 无斜杠的 `oaiprism` 会连 cmd/oaiprism/ 源码目录一起忽略
# （2026-10-03 发现：cmd 源码从未入库，CI 检出后编译失败）
/oaiprism
oaiprism.exe~

# 本地配置与凭据 —— 绝对不能提交
configs/config.yaml
secrets/*.json
!secrets/accounts.example.json
# cookies.txt 是浏览器导出的真实登录凭据，同样绝不入库
secrets/cookies.txt
secrets/*.txt

# 工作区本地数据（会话记录/抓包缓存）
.workbuddy/
*.db
*.sqlite
*.sqlite-shm
*.sqlite-wal

# 日志
*.log

# 抓包文件可能包含（已打码的）真实报文，同样不提交
captures/
*.jsonl

# 测试与覆盖率
coverage.out
*.test
.tmp_doc/

# 编辑器
.idea/
.vscode/
*.swp
.DS_Store

# 第三方参考资料与逆向分析产物（含 JS bundle，不入库）
.ref/

# Python 缓存
tools/__pycache__/
__pycache__/
*.pyc

# 临时抓包与测试生成文件
tools/*.png
tools/*_logs.json

# Playwright MCP 截图/日志输出
.playwright-mcp/
